# Trading (default: dry-run — logs signals, no orders)
LIVE_TRADING=false

# Polygon wallet (required for live orders)
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=
# 0=EOA, 1=Magic, 2=browser proxy (default when FUNDER set), 3=POLY_1271
POLYMARKET_SIGNATURE_TYPE=

# Optional L2 API creds (otherwise derived on first run)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

ORDER_SHARES=10

# RUST_LOG=info,polybot=debug
